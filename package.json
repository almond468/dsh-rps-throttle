{
  "name": "dsh-rps-throttle",
  "version": "2.0.0",
  "description": "Per-model request pacing gate for DeepSeek Harness: prevents 429 rate-limit errors by pacing requests per (host, model) with configurable RPS/RPM limits, sliding-window token budgets, and classified 429 handling (short backoff for rate walls, cooldown for quota walls).",
  "keywords": [
    "deepseek-harness",
    "deepseek-harness-plugin",
    "dsh",
    "dsh-plugin",
    "cordis-plugin",
    "llm",
    "rate-limit",
    "429",
    "rps",
    "rpm",
    "tpm",
    "model-limits",
    "throttle",
    "backoff",
    "openai-compatible"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js",
    "test": "node test/selftest.mjs"
  },
  "license": "MIT"
}
